    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CalculateWaterSpecular",
    "m_FunctionSource": "",
    "m_FunctionBody": "float specAngle = acos(dot(normalize(SunDir - ViewDir),Normal)); \nfloat expo = specAngle / Smoothness;\nSpecluar = exp(-expo * expo);"
}

